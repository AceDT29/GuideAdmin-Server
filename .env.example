# Puerto del servidor backend
PORT=5000

# Entorno de ejecución (development, production, test)
NODE_ENV=development

# Clave secreta para firma y verificación de tokens JWT
JWT_SECRET=tu_clave_secreta_jwt_aqui

# URL del frontend para autorización CORS (ej: http://localhost:5173 o URL en Netlify)
FRONTEND_URL=http://localhost:5173

# Conexión a Supabase (PostgreSQL)
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=tu_supabase_service_role_key_aqui

# Notificaciones por correo al Administrador (Nodemailer con Gmail / SMTP)
# Correo(s) donde recibirás la alerta de cada nueva oficina registrada (soporta varios separados por coma):
# Ej: ADMIN_NOTIFICATION_EMAIL=admin1@gmail.com, socio@gmail.com
ADMIN_NOTIFICATION_EMAIL=hola@gmail.com
# Cuenta de Gmail emisora y contraseña de aplicación de 16 caracteres de Google:
SMTP_EMAIL=tu_correo_emisor@gmail.com
SMTP_APP_PASSWORD=tu_contraseña_de_aplicacion_google
# Opcional (solo si usas un SMTP personalizado en lugar de Gmail):
# SMTP_HOST=smtp.ejemplo.com
# SMTP_PORT=587
# SMTP_SECURE=false

