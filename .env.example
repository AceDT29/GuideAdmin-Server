# Puerto del servidor backend
PORT=5000

# Entorno de ejecución (development, production, test)
NODE_ENV=development

# Clave secreta para firma y verificación de tokens JWT
JWT_SECRET=tu_clave_secreta_jwt_aqui

# URL del frontend para autorización CORS (ej: http://localhost:5173 o URL en Netlify)
FRONTEND_URL=http://localhost:5173

# Conexión a Supabase (PostgreSQL)
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=tu_supabase_service_role_key_aqui

# Expresión cron para purga periódica de guías (por defecto cada 16 horas)
CRON_GUIDES_PURGE="0 */16 * * *"

